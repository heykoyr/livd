# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# local data store (development adapter)
/.data/

# environment — never commit secrets
.env
.env.*
!.env.example

# supabase local
/supabase/.temp/
/supabase/.branches/

# testing
/coverage
/test-results
/playwright-report

# misc
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
*.tsbuildinfo

# editor
.idea/
.vscode/*
!.vscode/extensions.json
.seed-sql/

.vercel
.env*

# agent instruction files regenerated by `next dev` on every run. The filenames
# have to be spelled out for the rules to match — naming them here is what keeps
# them out of the repository, not what puts them in it.
/AGENTS.md
/CLAUDE.md

# editor and agent workspace settings — local convenience, not project config
/.claude/

# vitest JSON report — read by scripts/readme-counts.mjs, never committed
.vitest-report.json

# The README hero at full size — 2160px, 2.5 MB. What the README serves is
# docs/images/livd-hero.jpg, a 1440px copy an eleventh of the weight, which is
# already more pixels than GitHub can render. This is the master it came from:
# kept beside the project so it is easy to find, out of the repository so the
# same image is not carried twice.
/Livd.png
