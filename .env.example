# ---------------------------------------------------------------------------
# Livd — environment configuration
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored and must never
# be committed. No secret in this file is read by client code except the two
# values explicitly prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Public site origin. Canonical URLs, Open Graph tags, the sitemap — and the
# `emailRedirectTo` on every magic link, which is the one that bites.
#
# In production this MUST be the origin the site is actually served from. If it
# is wrong, or unset, Supabase discards the redirect Livd asks for and falls
# back to the Site URL configured in its own dashboard — which is how a
# production sign-in email came to point at localhost. See
# supabase/templates/README.md; both have to agree.
#
# Unset on a Vercel preview, the app falls back to VERCEL_URL, so previews are
# self-consistent without anyone configuring them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Data backend
#
# `local`    — file-backed store in ./.data, seeded with clearly-labelled demo
#              properties. No external service required. Default.
# `supabase` — Postgres + Auth + RLS. Requires the three values below and the
#              migrations in ./supabase/migrations to have been applied.
# ---------------------------------------------------------------------------
LIVD_DATA_BACKEND=local


# ---------------------------------------------------------------------------
# Supabase (only required when LIVD_DATA_BACKEND=supabase)
# ---------------------------------------------------------------------------

# Safe to expose to the browser. Row Level Security is what protects the data,
# not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses every Row Level Security policy.
# Never prefix with NEXT_PUBLIC_. Never import into a client component.
# Used exclusively by moderation/admin server code and the seed script.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Auth
#
# Nothing else is needed. Supabase Auth issues the magic link, and
# /auth/callback exchanges the code it carries for a session. The link's
# lifetime, the sender identity and the email template are configured in the
# Supabase dashboard, not here — see supabase/templates/README.md.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Sessions (local auth adapter only)
#
# Signs the development session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
LIVD_SESSION_SECRET=


# ---------------------------------------------------------------------------
# Geocoding (optional)
#
# What it is for: a property with no coordinate cannot be location-verified,
# and `createProperty` stores none unless something resolves one. Without a
# geocoder, properties a contributor adds simply do not offer the verification
# step — a legitimate state, not a broken one, and the review wizard handles it
# by omitting the step rather than showing one that can only fail.
#
# LIVD_GEOCODER is a comma-separated list, tried in order until one gives a
# confident answer. The useful arrangement is a commercial provider followed by
# nominatim, because the two fail differently: a commercial provider fails on
# quota, billing and outage, while nominatim fails on coverage. Chaining them
# means a lapsed card degrades coverage in the Gulf rather than removing
# geocoding everywhere.
#
#   LIVD_GEOCODER=google,nominatim     recommended
#   LIVD_GEOCODER=mapbox,nominatim     no card needed to start
#   LIVD_GEOCODER=nominatim            free, Europe and North America only
#
# COVERAGE IS THE WHOLE POINT, AND IT IS NOT UNIFORM. Measured against real
# addresses, OpenStreetMap resolves Berlin, Austin and London to buildings,
# returns only a road for Lagos and Cape Town, and finds nothing for Dubai.
# Google holds building or establishment data in all of them. Livd is a global
# product and cannot have a trust feature that works in Europe and not in
# Nigeria, which is why the commercial providers are here.
#
# WHATEVER THE PROVIDER, ANYTHING LESS PRECISE THAN A BUILDING IS REFUSED.
# Nominatim answers "8 Admiralty Way, Lagos" with the road — a feature spanning
# 1,716 metres — and a point along it can sit most of a kilometre from the
# building. Stored, that produces the worst outcome this system has: a resident
# standing at their own front door being told they are not there. No coordinate
# means the verification step is not offered; a wrong one means it is offered
# and cannot be passed.
# ---------------------------------------------------------------------------
LIVD_GEOCODER=

# Google Maps Geocoding API — the best coverage in Lagos, Dubai, Mumbai and
# most of the places OpenStreetMap is thin.
#
# console.cloud.google.com > APIs & Services > enable "Geocoding API" >
# Credentials > Create credentials > API key. It needs a billing account with a
# card, and Google's free monthly credit covers ordinary use on its own.
#
# Cost is per request, but the volume is bounded: property creation is
# rate-limited to five an hour per contributor and duplicate addresses are
# rejected before geocoding, so this is charged once per genuinely new
# building. A few thousand a month is single-digit dollars.
#
# RESTRICT THE KEY. In the Google console set an API restriction to the
# Geocoding API only. Livd calls it from the server, never the browser, so it
# is never exposed to a visitor — but a key with no restriction is a key that
# can be used for anything if it ever leaks.
GOOGLE_MAPS_API_KEY=

# Mapbox — coverage between OpenStreetMap and Google, and its free tier does
# not ask for a card, so it is the quickest way to improve on the free option.
# account.mapbox.com > Tokens. A default public token is enough.
MAPBOX_ACCESS_TOKEN=

# Required only when `nominatim` is in the list. Its usage policy requires a
# genuine contact — an email address or a URL — in the User-Agent, so without
# this the provider is skipped rather than used in breach of it.
LIVD_GEOCODER_CONTACT=


# ---------------------------------------------------------------------------
# Google sign-in (optional)
#
# Set to `true` only once BOTH halves exist:
#
#   1. An OAuth client in Google Cloud whose only authorised redirect URI is
#      your Supabase callback — https://<project-ref>.supabase.co/auth/v1/callback
#   2. That client ID and secret entered in Supabase, under
#      Authentication > Sign In / Providers > Google, with the provider enabled
#
# Off by default and gated deliberately. Livd cannot see either half, and a
# sign-in button that leads to an error page is worse than no button — it is
# the control a new visitor is most likely to press first.
#
# Worth having: Supabase email links are single-use, and Gmail follows every
# link it delivers within about fifteen seconds to scan it, spending the token
# before the person opens the message. Google sign-in emails nothing, so there
# is nothing to intercept.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SIGN_IN=false


# ---------------------------------------------------------------------------
# Demo data
#
# When `true`, seeded demo properties are visible and are labelled as sample
# data everywhere they appear. Set to `false` for any real deployment.
# ---------------------------------------------------------------------------
LIVD_SHOW_DEMO_DATA=true
